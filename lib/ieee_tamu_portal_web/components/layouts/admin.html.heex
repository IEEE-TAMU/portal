<div class="min-h-screen bg-gray-50">
  <header class="bg-white shadow-sm border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        <div class="flex items-center space-x-4 sm:space-x-8 min-w-0">
          <h1 class="hidden sm:block text-xl font-semibold text-gray-900">
            IEEE TAMU Portal - Admin
          </h1>
          <h1 class="sm:hidden text-xl font-semibold text-gray-900">Admin</h1>
          <nav class="flex-1 flex items-center space-x-2 sm:space-x-4 overflow-x-auto whitespace-nowrap">
            <.navbar_button
              name="Dashboard"
              navigate={~p"/admin"}
              icon="hero-home"
            />
            <.navbar_button
              name="Members"
              navigate={~p"/admin/members"}
              icon="hero-users"
            />
            <.navbar_button
              name="Events"
              navigate={~p"/admin/events"}
              icon="hero-calendar-days"
            />
            <.navbar_button
              name="Check-in"
              navigate={~p"/admin/checkin"}
              icon="hero-qr-code"
            />
            <.navbar_button
              name="Verify"
              navigate={~p"/admin/verification"}
              icon="hero-check-badge"
            />
            <.navbar_button
              :if={@current_member.role == :admin}
              name="Officers"
              navigate={~p"/admin/officers"}
              icon="hero-shield-check"
            />
          </nav>
        </div>
        <div class="hidden md:flex items-center space-x-4 text-sm text-gray-600">
          <span class="max-w-[22ch] truncate" title={@current_member.email}>
            {@current_member.email}
          </span>
          <span class="inline-flex items-center rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-medium text-gray-700">
            {IeeeTamuPortal.Accounts.Member.role_label(@current_member.role)}
          </span>
          <.navbar_button
            name="Log out"
            href={~p"/members/log_out"}
            method="delete"
            icon="hero-arrow-left-start-on-rectangle"
          />
        </div>
      </div>
    </div>
  </header>

  <main class="max-w-7xl mx-auto px-4 py-6 sm:px-6 lg:px-8">
    <.flash_group flash={@flash} />
    {@inner_content}
  </main>
</div>
